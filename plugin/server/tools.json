[
  {
    "name": "shader_guide",
    "annotations": { "title": "Shader guide", "readOnlyHint": true, "openWorldHint": false },
    "description": "Returns the playground guide: manifest format, WESL rules, available bindings, fragment/vertex templates. Read it before writing shaders.",
    "inputSchema": { "type": "object", "properties": {} }
  },
  {
    "name": "list_projects",
    "annotations": { "title": "List projects", "readOnlyHint": true, "openWorldHint": false },
    "description": "List all groups and projects.",
    "inputSchema": { "type": "object", "properties": {} }
  },
  {
    "name": "get_project",
    "annotations": { "title": "Get project", "readOnlyHint": true, "openWorldHint": false },
    "description": "Get a project's manifest, file list and text file sources.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Project id: `name` or `group/name`, lowercase snake_case" },
        "include_sources": { "type": "boolean", "default": true }
      },
      "required": ["id"]
    }
  },
  {
    "name": "create_project",
    "annotations": { "title": "Create project", "readOnlyHint": false, "destructiveHint": true, "idempotentHint": false, "openWorldHint": false },
    "description": "Create a project (manifest + shader/text files), then compile it off-screen and return errors. Works independently of what the viewer shows. Put variants in one group with ids like `portals/v1_swirl`.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Project id: `name` or `group/name`, lowercase snake_case" },
        "manifest": { "type": "object", "description": "Full project.json content (see shader_guide): name, description, camera, background, grid, objects[]" },
        "files": {
          "type": "object",
          "description": "Map of relative path -> file text (e.g. {\"portal.wesl\": \"...\"}).",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "group_name": { "type": "string", "description": "Optional display name for the group (when id has a group)" },
        "overwrite": { "type": "boolean", "default": false, "description": "Replace an existing project entirely" },
        "compile": { "type": "boolean", "default": true },
        "preview": { "type": "boolean", "default": false, "description": "Also return a rendered preview image" }
      },
      "required": ["id", "manifest"]
    }
  },
  {
    "name": "update_project",
    "annotations": { "title": "Update project", "readOnlyHint": false, "destructiveHint": true, "idempotentHint": false, "openWorldHint": false },
    "description": "Write/delete files and/or replace the manifest of an existing project, then compile it and return errors.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Project id: `name` or `group/name`, lowercase snake_case" },
        "manifest": { "type": "object", "description": "Full project.json content (replaces the current one)" },
        "files": {
          "type": "object",
          "description": "Map of relative path -> file text; null deletes the file.",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "compile": { "type": "boolean", "default": true },
        "preview": { "type": "boolean", "default": false }
      },
      "required": ["id"]
    }
  },
  {
    "name": "delete_project",
    "annotations": { "title": "Delete project", "readOnlyHint": false, "destructiveHint": true, "idempotentHint": true, "openWorldHint": false },
    "description": "Permanently delete a project and all its files.",
    "inputSchema": {
      "type": "object",
      "properties": { "id": { "type": "string" } },
      "required": ["id"]
    }
  },
  {
    "name": "set_group",
    "annotations": { "title": "Set group", "readOnlyHint": false, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false },
    "description": "Create or update a group's display name, description and spacing (distance between projects when the whole group is shown).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "group": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "spacing": { "type": "number" }
      },
      "required": ["group"]
    }
  },
  {
    "name": "add_texture",
    "annotations": { "title": "Add texture", "readOnlyHint": false, "destructiveHint": true, "idempotentHint": true, "openWorldHint": false },
    "description": "Add a texture to a project: procedural PNG, base64 image data, or a copy of a local image file.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": { "type": "string" },
        "path": { "type": "string", "description": "e.g. textures/noise.png" },
        "procedural": {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "enum": ["noise", "fbm", "voronoi", "checker", "gradient", "radial", "stripes"] },
            "size": { "type": "integer", "default": 256 },
            "scale": { "type": "number", "default": 8 },
            "seed": { "type": "integer", "default": 0 },
            "color_a": { "type": "array", "items": { "type": "number" }, "description": "linear RGBA at t=0" },
            "color_b": { "type": "array", "items": { "type": "number" }, "description": "linear RGBA at t=1" }
          }
        },
        "base64": { "type": "string" },
        "source_path": { "type": "string", "description": "Absolute path of a local file to copy" }
      },
      "required": ["project", "path"]
    }
  },
  {
    "name": "import_file",
    "annotations": { "title": "Import file", "readOnlyHint": false, "destructiveHint": true, "idempotentHint": true, "openWorldHint": false },
    "description": "Copy a binary file (e.g. .glb mesh, image) into a project from a local path or base64.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": { "type": "string" },
        "path": { "type": "string" },
        "base64": { "type": "string" },
        "source_path": { "type": "string", "description": "Absolute path of a local file to copy" }
      },
      "required": ["project", "path"]
    }
  },
  {
    "name": "compile_project",
    "annotations": { "title": "Compile project", "readOnlyHint": true, "openWorldHint": false },
    "description": "Compile a project off-screen (does not change the viewer) and return shader/asset errors plus an optional preview image.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "preview": { "type": "boolean", "default": true }
      },
      "required": ["id"]
    }
  },
  {
    "name": "open_in_viewer",
    "annotations": { "title": "Open in viewer", "readOnlyHint": false, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false },
    "description": "Show a project, or a whole group side by side, in the user's viewer. Changes what the user sees; use when asked.",
    "inputSchema": {
      "type": "object",
      "properties": { "project": { "type": "string" }, "group": { "type": "string" } }
    }
  },
  {
    "name": "screenshot",
    "annotations": { "title": "Screenshot viewer", "readOnlyHint": true, "openWorldHint": false },
    "description": "Capture the viewer as the user currently sees it.",
    "inputSchema": { "type": "object", "properties": {} }
  },
  {
    "name": "viewer_state",
    "annotations": { "title": "Viewer state", "readOnlyHint": true, "openWorldHint": false },
    "description": "What the viewer is showing, its errors, and recent warnings/errors from the log.",
    "inputSchema": { "type": "object", "properties": {} }
  }
]
